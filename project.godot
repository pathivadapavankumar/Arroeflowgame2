; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arrowflow"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.965, 0.961, 0.937, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/image="res://assets/template/ui/boot.png"
config/icon="res://assets/share/favicon.png"

[gui]

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/handheld/orientation.mobile=1

[importer_defaults]

; Managed delivery reimports textures without relying on workstation caches.
texture={
"compress/lossy_quality": 0.85,
"compress/mode": 1
}

[physics]

2d/default_gravity=820.0
2d/default_linear_damp=0.08
2d/default_angular_damp=0.2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.965, 0.961, 0.937, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/mushies_export/plugin.cfg")
